# ==========================================
# Aegis Platform - API & Worker Configuration
# ==========================================

# Server Environment
ENVIRONMENT=development
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-32-character-secret

# PostgreSQL Database (e.g. Neon or Supabase free tier)
# Format: postgresql+asyncpg://[user]:[password]@[host]:[port]/[database]?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/aegis_db

# Redis Message Broker (e.g. Upstash serverless Redis free tier or local)
# Format: rediss://default:[password]@[endpoint]:6379/0 (use 'rediss://' for Upstash TLS)
REDIS_URL=redis://localhost:6379/0

# Cryptography - Dual-Cipher Keys
# AEGIS_MASTER_KEY must be a 64-character hex string (32 bytes) for AES-256-GCM
AEGIS_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AEGIS_BLIND_PEPPER is a salt string used for HMAC-SHA256 blind indexing
AEGIS_BLIND_PEPPER=change-this-to-a-secure-pepper-salt-key-string

# Alerting - Slack Incoming Webhook (100% Free)
# Set your Slack Incoming Webhook URL here to receive instant Block Kit leak alerts
SLACK_WEBHOOK_URL=

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:3000,https://aegis-web.vercel.app

# Aegis Platform Environment Configuration
ENVIRONMENT=development
PORT=8000
DEBUG=true

# Security & Secrets
SECRET_KEY=change-this-to-a-secure-random-32-character-secret
AEGIS_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AEGIS_BLIND_PEPPER=local-dev-pepper-secret-key-32chars
WEBHOOK_SECRET_DEFAULT=aegis-default-webhook-secret

# Database & Broker
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/aegis_db
REDIS_URL=redis://localhost:6379/0

# Domains & URLs
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Integrations (Optional)
SLACK_WEBHOOK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
